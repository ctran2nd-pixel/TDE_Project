! inlist_make_brown_dwarf

&star_job

   show_log_description_at_start = .false.

   create_initial_model = .true.

   save_model_when_terminate = .true.
   save_model_filename = 'final.mod'

   required_termination_code_string = 'max_age'

   mass_in_gm_for_create_initial_model = 1.139160e+32

   radius_in_cm_for_create_initial_model = 3.495550e+10

/ ! end of star_job namelist


&eos

/ ! end of eos namelist


&kap

   Zbase = 0.030000

   kap_lowT_prefix = 'lowT_Freedman11'

/ ! end of kap namelist


&controls

   mlt_make_surface_no_mixing = .false.

   convergence_ignore_equL_residuals = .true.

   make_gradr_sticky_in_solver_iters = .true.

   use_gold2_tolerances = .true.

   max_model_number = 900

   initial_z = 0.030000

   max_age = 1.000000e+09

   energy_eqn_option = 'dedt'

   warning_limit_for_max_residual = 1d99

   num_trace_history_values = 2

   trace_history_value_name(1) = 'rel_E_err'
   trace_history_value_name(2) = 'log_rel_run_E_err'

   max_resid_jump_limit = 1d15
   max_corr_jump_limit = 1d15

   photo_interval = 50
   profile_interval = 100
   history_interval = 10
   terminal_interval = 10

   write_header_frequency = 50

/ ! end of controls namelist


&pgstar

   Grid1_win_flag = .true.

   TRho_Profile_xmin = -8
   TRho_Profile_xmax = 4
   TRho_Profile_ymin = 2
   TRho_Profile_ymax = 6

/ ! end of pgstar namelist
